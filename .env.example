# ---------------------------------------------------------------------------
# Konfigurasi Supabase untuk fitur Komentar / Buku Tamu
# ---------------------------------------------------------------------------
# Salin file ini menjadi ".env" lalu isi nilainya dari dashboard Supabase:
# Project Settings -> API
#
#   VITE_SUPABASE_URL     -> "Project URL"   (contoh: https://xxxxx.supabase.co)
#   VITE_SUPABASE_ANON_KEY-> "anon public"   (kunci publik, aman dipakai di frontend)
#
# Selama dua nilai ini kosong, section komentar otomatis berjalan dalam
# "mode demo" (komentar hanya tersimpan di browser sendiri).
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
